# History files
.Rhistory
.Rapp.history

# Session Data files
.RData

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# omc session state
.omc/

# Per-run scraper logfiles (written to the repo root by logging.basicConfig).
# Unanchored so the daily driver's `git add .` can never sweep them -- at the
# root or after being tucked into logs/. The already-tracked root logfiles and
# the tracked per-season logs/*.log are unaffected (ignore rules never apply
# to tracked files).
*_logfile.txt

# Driver stdout redirects are runtime artifacts (the daily driver runs `git add .`).
/*.out

# Python bytecode. The sibling hoopR-nba-raw has ignored these since its own
# cleanup; this repo did not, and its daily driver runs `git add .` -- so the
# only thing keeping bytecode out of the archive was luck.
__pycache__/
*.pyc
